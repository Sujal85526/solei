-- Shared test helpers (loaded first; pgTAP runs files alphabetically in one session per file,
-- so each test file re-creates what it needs via these functions in the `tests` schema).
set client_min_messages = warning;
create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

create or replace function tests.create_user(p_email text)
returns uuid
language plpgsql
security definer
as $$
declare v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email, encrypted_password, email_confirmed_at, created_at, updated_at, raw_app_meta_data, raw_user_meta_data)
  values (v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email, '', now(), now(), now(), '{}', '{}');
  return v_id;
end;
$$;

create or replace function tests.create_staff(p_email text, p_role text, p_active boolean default true)
returns uuid
language plpgsql
security definer
as $$
declare v_id uuid := tests.create_user(p_email);
begin
  insert into public.staff_profiles (user_id, full_name, email, role_id, active)
  select v_id, split_part(p_email, '@', 1), p_email, r.id, p_active from public.roles r where r.key = p_role;
  return v_id;
end;
$$;

-- Act as a user. aal2 = passed TOTP.
create or replace function tests.login_as(p_user uuid, p_aal text default 'aal2')
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_user, 'role', 'authenticated', 'aal', p_aal)::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create or replace function tests.login_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end;
$$;

create or replace function tests.logout()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

grant execute on all functions in schema tests to anon, authenticated;

-- ---------------------------------------------------------------------------------------------
-- Known starting point, so the files pass on a freshly seeded DB and on a copy of live data alike.
-- Everything below runs inside each file's transaction and is rolled back with it.

-- Owner and manager need MFA (T15), whatever the DB's own setting is (live may have it off).
update public.roles set requires_mfa = true where key in ('owner', 'manager') and not requires_mfa;

-- The test catalogue: the seed's 8 bottles under TST-* SKUs, at seed prices and costs, 50 each in
-- the default location. Tests use these instead of the real products, whose prices can change.
insert into public.categories (slug, name, sort) values ('perfume', 'Perfumes', 0), ('all_over_spray', 'All-over sprays', 1)
on conflict (slug) do nothing;
insert into public.destinations (slug, name, country, sort)
select d.slug, initcap(d.slug), 'Test', 99
from unnest(array['cannes', 'marbella', 'verona', 'capri', 'santorini', 'soho', 'monaco', 'mayfair']) d (slug)
on conflict (slug) do nothing;
insert into public.stock_locations (name, is_default)
select 'Main stock', true where not exists (select 1 from public.stock_locations where is_default);

with t (dest, cat, kind, sku, label, ml, price, cost) as (values
  ('cannes', 'perfume', 'Perfume', 'TST-P-CAN-50', '50 ml', 50, 28000, 9000),
  ('marbella', 'perfume', 'Perfume', 'TST-P-MAR-50', '50 ml', 50, 28000, 9000),
  ('verona', 'perfume', 'Perfume', 'TST-P-VER-50', '50 ml', 50, 28000, 9000),
  ('capri', 'perfume', 'Perfume', 'TST-P-CAP-50', '50 ml', 50, 28000, 9000),
  ('santorini', 'perfume', 'Perfume', 'TST-P-SAN-50', '50 ml', 50, 28000, 9000),
  ('soho', 'all_over_spray', 'All-over spray', 'TST-S-SOH-100', '100 ml', 100, 19000, 5500),
  ('monaco', 'all_over_spray', 'All-over spray', 'TST-S-MON-100', '100 ml', 100, 19000, 5500),
  ('mayfair', 'all_over_spray', 'All-over spray', 'TST-S-MAY-100', '100 ml', 100, 19000, 5500)
), p as (
  insert into public.products (category_id, destination_id, name, slug, sort)
  select c.id, d.id, initcap(t.dest) || ' ' || t.kind, lower(t.sku), 900
  from t join public.categories c on c.slug = t.cat join public.destinations d on d.slug = t.dest
  returning id, slug
), v as (
  insert into public.product_variants (product_id, label, size_ml, sku, price_fils, low_stock_threshold)
  select p.id, t.label, t.ml, t.sku, t.price, 5 from t join p on p.slug = lower(t.sku)
  returning id, sku
), c as (
  insert into public.variant_costs (variant_id, cost_fils) select v.id, t.cost from v join t using (sku)
)
insert into public.stock_movements (variant_id, location_id, qty, type, reason)
select v.id, l.id, 50, 'receive', 'Test opening stock' from v cross join public.stock_locations l where l.is_default;
