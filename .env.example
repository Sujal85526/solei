# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (local values come from `pnpm db:start` / `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=

# --- Payments ---
# stripe | mock. Defaults to mock when STRIPE_SECRET_KEY is empty (local dev / CI).
PAYMENT_PROVIDER=
# Stripe TEST mode only in Phase 1 (sk_test_…). Webhook endpoint: /api/webhooks/payments/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mock payments are refused in production builds unless this is 1 (CI e2e only).
ALLOW_MOCK_PAYMENTS=
# Optional dedicated secrets (otherwise derived from SUPABASE_SECRET_KEY)
MOCK_PAYMENT_SECRET=
ORDER_LINK_SECRET=

# --- Email (Resend) ---
# Empty = emails are logged (Admin → Notifications → Outbox) instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Solei <hello@example.com>"
# Outside production only these recipients get real email (comma list of emails or @domains).
EMAIL_ALLOWLIST=
# Set to 1 on the live site only.
EMAIL_ALLOW_ALL=
# Testing only (no Resend yet): fixed 6-digit code for account verification / password reset.
ACCOUNT_TEST_CODE=
# Ziina payments (PAYMENT_PROVIDER=ziina): API key with write_payment_intents; 1 = test payments.
ZIINA_API_KEY=
ZIINA_TEST_MODE=

# Phase 2 — abandoned cart reminders. CART_LINK_SECRET signs the email links (derived from the
# Supabase secret when empty). CRON_SECRET guards /api/cron/* (cart-reminders, birthdays, tracking).
CART_LINK_SECRET=
CRON_SECRET=
# Phase 2 — operations. Only the stand-ins exist until real accounts do: WhatsApp messages are logged
# to the outbox ("log"), couriers are simulated ("mock"). Leave empty for those defaults.
MESSAGING_PROVIDER=
COURIER_PROVIDER=
# "Plan your event" bookings: 1 opens /events and Admin → Bookings; unset = "Coming soon".
NEXT_PUBLIC_FEATURE_BOOKINGS=
# 1 = the Points & tiers on/off switch is read-only (previews sharing the live database).
POINTS_SWITCH_LOCKED=
