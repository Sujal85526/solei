# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (local values come from `pnpm db:start` / `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=

# --- Payments ---
# ngenius | ziina | stripe | mock. Empty = ngenius when NGENIUS_API_KEY is set, else mock (local dev / CI).
PAYMENT_PROVIDER=
# Network International N-Genius (the client's gateway). API key = the portal's service-account key,
# as-is. NGENIUS_SANDBOX=1 uses the sandbox gateway. Webhook endpoint: /api/webhooks/payments/ngenius,
# with the custom header "x-solei-webhook-secret: <NGENIUS_WEBHOOK_SECRET>" set in the portal.
NGENIUS_API_KEY=
NGENIUS_OUTLET_REF=
NGENIUS_SANDBOX=1
NGENIUS_WEBHOOK_SECRET=
# Stripe TEST mode only in Phase 1 (sk_test_…). Webhook endpoint: /api/webhooks/payments/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mock payments are refused in production builds unless this is 1 (CI e2e only).
ALLOW_MOCK_PAYMENTS=
# Optional dedicated secrets (otherwise derived from SUPABASE_SECRET_KEY)
MOCK_PAYMENT_SECRET=
ORDER_LINK_SECRET=

# --- Email (Resend) ---
# Empty = emails are logged (Admin → Notifications → Outbox) instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Solei <hello@example.com>"
# Outside production only these recipients get real email (comma list of emails or @domains).
EMAIL_ALLOWLIST=
# Set to 1 on the live site only.
EMAIL_ALLOW_ALL=
# Testing only (no Resend yet): fixed 6-digit code for account verification / password reset.
ACCOUNT_TEST_CODE=
# Ziina payments (previous gateway; PAYMENT_PROVIDER=ziina): API key with write_payment_intents; 1 = test payments.
ZIINA_API_KEY=
ZIINA_TEST_MODE=
